-    return x * 0.5 * (1.0 + tanh(0.5 * x));
+    let e = exp(-abs(x));
+    return x * select(e / (1.0 + e), 1.0 / (1.0 + e), x >= 0.0);
   } else if (kind == 12u) {
     // mish_scale8(x) = x*tanh(softplus(8x)) = mish(8x)/8 (fp16-stability rescale).
     let z = 8.0 * x;
     let sp = max(z, 0.0) + log(1.0 + exp(-abs(z)));
-    return x * tanh(sp);
+    let e = exp(-2.0 * sp);
+    return x * (1.0 - e) / (1.0 + e);
   }
   return x;
 }
